{
  "ci": {
    "collect": {
      "startServerCommand": "PORT=4174 npm start",
      "startServerReadyPattern": "listening",
      "url": ["http://localhost:4174/sign-in", "http://localhost:4174/dev/states"],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}

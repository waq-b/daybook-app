# Copy to .env for local development. Both Supabase values are public by
# design: they ship inside the web app, and row level security protects the
# data. The app throws at start-up if either is missing.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key for that project.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Everything below is optional and commented out.

# Port for the Fastify server (`npm run dev:server`, `npm start`). Default 3000.
# PORT=3000

# Version string shown in Settings and reported by /api/health. Render sets
# RENDER_GIT_COMMIT itself; locally it falls back to "dev".
# RENDER_GIT_COMMIT=

# Database tests (`npm run test:db`): a Postgres you can create databases on.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Live suite (`npm run e2e:live`): the deployed site and the Supabase project it checks.
# LIVE_URL=
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=

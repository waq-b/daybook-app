{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "node_modules/.tmp/test.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node", "vite/client", "vite-plugin-pwa/client"],
    "noEmit": true
  },
  "include": ["src", "server", "scripts/**/*.ts", "e2e", "supabase/tests", "e2e-live"]
}

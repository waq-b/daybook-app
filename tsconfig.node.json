{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "node_modules/.tmp/node.tsbuildinfo",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "scripts",
    "src/copy.ts",
    "playwright.config.ts",
    "vitest.db.config.ts",
    "playwright.live.config.ts"
  ],
  "exclude": ["scripts/**/*.test.ts", "scripts/tokens.ts"]
}
